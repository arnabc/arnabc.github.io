---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { postUrl, tagUrl } from '../../../../lib/postUrl';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  const byCategory = new Map<string, { tag: string; posts: typeof posts }>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      const category = tagUrl(tag).split('/').filter(Boolean).pop()!;
      const entry = byCategory.get(category) ?? { tag, posts: [] };
      entry.posts.push(post);
      byCategory.set(category, entry);
    }
  }

  return [...byCategory.entries()].map(([category, { tag, posts: categoryPosts }]) => ({
    params: { category },
    props: {
      tag,
      posts: categoryPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`Posts tagged “${tag}”`} description={`All posts tagged ${tag}.`}>
  <h1>Posts tagged &ldquo;{tag}&rdquo;</h1>
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <a href={postUrl(post)}>{post.data.title}</a>
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
        </time>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .post-list li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border);
  }

  .post-list time {
    color: var(--muted);
    white-space: nowrap;
    font-size: 0.9rem;
  }
</style>
