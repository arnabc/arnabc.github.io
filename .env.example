# GitHub "owner/repo" slug that Keystatic's admin UI edits via storage: { kind: 'github' }.
# Leave unset to use local filesystem storage (Keystatic writes directly to disk instead
# of opening GitHub PRs) — the default for local development.
PUBLIC_KEYSTATIC_GITHUB_REPO=

# Cloudflare Web Analytics beacon token (Cloudflare dashboard → your zone → Analytics →
# Web Analytics → enable → copy the token). Leave unset to disable analytics entirely.
PUBLIC_CF_WEB_ANALYTICS_TOKEN=
